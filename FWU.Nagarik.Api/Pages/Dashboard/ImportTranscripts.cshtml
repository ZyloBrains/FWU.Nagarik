@page
@model FWU.Nagarik.Api.Pages.Dashboard.ImportTranscriptsModel
@{
    ViewData["Title"] = "Import Transcripts";
}

<h2><i class="bi bi-upload"></i> Import Transcripts from CSV</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show">
        @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Upload CSV File</h5>
            </div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Select CSV File <span class="text-danger">*</span></label>
                        <input type="file" name="CsvFile" class="form-control" accept=".csv" required>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-cloud-upload"></i> Import
                    </button>
                </form>
            </div>
        </div>

        @if (Model.Result != null)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Import Results</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="card text-center border-success">
                                <div class="card-body">
                                    <div class="text-success display-6">@Model.Result.StudentsCreated</div>
                                    <div class="text-muted">Students Created</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center border-info">
                                <div class="card-body">
                                    <div class="text-info display-6">@Model.Result.StudentsUpdated</div>
                                    <div class="text-muted">Students Updated</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center border-primary">
                                <div class="card-body">
                                    <div class="text-primary display-6">@Model.Result.TranscriptsCreated</div>
                                    <div class="text-muted">Transcripts</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center border-secondary">
                                <div class="card-body">
                                    <div class="text-secondary display-6">@Model.Result.TranscriptsUpdated</div>
                                    <div class="text-muted">Transcripts Updated</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.Result.RowsSkipped > 0)
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>@Model.Result.RowsSkipped</strong> row(s) skipped due to validation errors. See details below.
                        </div>
                    }

                    @if (Model.Result.Errors.Any())
                    {
                        <hr>
                        <h6 class="text-danger">Errors (@Model.Result.Errors.Count):</h6>
                        <ul class="list-group list-group-flush" style="max-height: 300px; overflow-y: auto;">
                            @foreach (var error in Model.Result.Errors)
                            {
                                <li class="list-group-item text-danger" style="font-size: 0.85rem;">@error</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">CSV Format Guide</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">Expected CSV columns:</p>
                <ul class="list-unstyled" style="font-size: 0.85rem;">
                    <li><code>RegistrationNo</code></li>
                    <li><code>FullName</code></li>
                    <li><code>CollegeName</code></li>
                    <li><code>FacultyName</code></li>
                    <li><code>ProgramName</code></li>
                    <li><code>AcademicYearName</code></li>
                    <li><code>year</code> (I, II, III, IV)</li>
                    <li><code>part</code> (I, II)</li>
                    <li><code>ExamRollNo</code></li>
                    <li><code>SubjectCode</code></li>
                    <li><code>SubjectName</code></li>
                    <li><code>CreditHour</code></li>
                    <li><code>GradeLetter</code></li>
                    <li><code>GradePoint</code></li>
                    <li><code>IssueNo</code></li>
                    <li><code>CGPA</code></li>
                    <li><code>PrintedDate</code></li>
                </ul>

                <hr>
                <h6>Grade Mapping:</h6>
                <table class="table table-sm" style="font-size: 0.8rem;">
                    <thead>
                        <tr><th>Letter</th><th>Value</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>A</td><td>4.0</td></tr>
                        <tr><td>A-</td><td>3.7</td></tr>
                        <tr><td>B+</td><td>3.3</td></tr>
                        <tr><td>B</td><td>3.0</td></tr>
                        <tr><td>B-</td><td>2.7</td></tr>
                        <tr><td>C+</td><td>2.3</td></tr>
                        <tr><td>C</td><td>2.0</td></tr>
                        <tr><td>C-</td><td>1.7</td></tr>
                        <tr><td>D+</td><td>1.3</td></tr>
                        <tr><td>D</td><td>1.0</td></tr>
                        <tr><td>F</td><td>0.0</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
