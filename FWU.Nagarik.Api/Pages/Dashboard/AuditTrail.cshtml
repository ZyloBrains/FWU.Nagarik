@page
@model FWU.Nagarik.Api.Pages.Dashboard.AuditTrailModel
@{
    ViewData["Title"] = "Audit Trail";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Audit Trail</h2>
</div>

<form method="get" class="mb-4">
    <div class="row g-3">
        <div class="col-md-2">
            <select name="searchAction" class="form-select">
                <option value="">All Actions</option>
                <option value="StudentVerified" selected="@(Model.SearchAction == "StudentVerified")">Student Verified</option>
                <option value="TranscriptRetrieved" selected="@(Model.SearchAction == "TranscriptRetrieved")">Transcript Retrieved</option>
                <option value="TokenGenerated" selected="@(Model.SearchAction == "TokenGenerated")">Token Generated</option>
                <option value="ApiKeyCreated" selected="@(Model.SearchAction == "ApiKeyCreated")">API Key Created</option>
                <option value="ApiKeyToggled" selected="@(Model.SearchAction == "ApiKeyToggled")">API Key Toggled</option>
                <option value="ApiKeyDeleted" selected="@(Model.SearchAction == "ApiKeyDeleted")">API Key Deleted</option>
                <option value="StudentEdited" selected="@(Model.SearchAction == "StudentEdited")">Student Edited</option>
                <option value="UserRoleAssigned" selected="@(Model.SearchAction == "UserRoleAssigned")">UserRole Assigned</option>
                <option value="RoleCreated" selected="@(Model.SearchAction == "RoleCreated")">Role Created</option>
                <option value="RoleDeleted" selected="@(Model.SearchAction == "RoleDeleted")">Role Deleted</option>
            </select>
        </div>
        <div class="col-md-3">
            <input type="text" name="searchClient" class="form-control" placeholder="Search by client name or org" value="@Model.SearchClient">
        </div>
        <div class="col-md-2">
            <select name="searchStatus" class="form-select">
                <option value="">All Status</option>
                <option value="Success" selected="@(Model.SearchStatus == "Success")">Success</option>
                <option value="Failed" selected="@(Model.SearchStatus == "Failed")">Failed</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Timestamp</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Client</th>
                    <th>IP</th>
                    <th>Method</th>
                    <th>Path</th>
                    <th>Code</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @{int i = (Model.CurrentPage - 1) * 50 + 1;}
                @foreach (var log in Model.Logs)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><span class="badge bg-secondary">@log.Action</span></td>
                        <td>@log.EntityType @(log.EntityId != null ? $"({log.EntityId})" : "")</td>
                        <td>@(log.ClientName ?? "-")<br><small class="text-muted">@(log.ClientOrg ?? "")</small></td>
                        <td><small>@(log.ClientIp ?? "-")</small></td>
                        <td>@log.RequestMethod</td>
                        <td><small>@log.RequestPath</small></td>
                        <td>@log.ResponseCode</td>
                        <td>
                            <span class="badge bg-@(log.IsSuccess ? "success" : "danger")">
                                @(log.IsSuccess ? "OK" : "Fail")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Logs.Any())
        {
            <p class="text-center text-muted py-4">No audit records found</p>
        }
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <div class="mt-3">
        <nav>
            <ul class="pagination justify-content-end">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="?page=@(Model.CurrentPage - 1)&searchAction=@Model.SearchAction&searchClient=@Model.SearchClient&searchStatus=@Model.SearchStatus">Previous</a>
                    </li>
                }
                <li class="page-item active"><span class="page-link">Page @Model.CurrentPage of @Model.TotalPages</span></li>
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="?page=@(Model.CurrentPage + 1)&searchAction=@Model.SearchAction&searchClient=@Model.SearchClient&searchStatus=@Model.SearchStatus">Next</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
}
